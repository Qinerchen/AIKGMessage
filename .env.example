# LLM 配置（复制为 .env 并填入 key；.env 已被 gitignore，不会入库）
# 默认对接智谱 GLM 的 Anthropic 兼容端点，也可换成 Anthropic 官方（清空 BASE_URL）。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# 模型可自行更换（如 glm-5 / glm-4.5-air / claude-haiku-4-5 等）
GLM_MODEL_CLASSIFY=glm-4.5-flash
GLM_MODEL_SUMMARIZE=glm-4.6
